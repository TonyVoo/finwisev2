{
  "name": "@expense-tracker/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first Expo client. SQLite is the source of truth the UI reads from; the network is just a background process.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci --forceExit",
    "test:watch": "jest --watch",
    "doctor": "expo-doctor",
    "bundle:check": "expo export --platform ios --platform android --output-dir .expo/export-check --clear"
  },
  "dependencies": {
    "@expense-tracker/shared": "workspace:*",
    "@expo/vector-icons": "15.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "5.104.1",
    "expo": "57.0.27",
    "expo-background-task": "57.0.21",
    "expo-constants": "57.0.21",
    "expo-crypto": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-image-manipulator": "57.0.21",
    "expo-image-picker": "57.0.20",
    "expo-linking": "57.0.12",
    "expo-notifications": "~57.0.24",
    "expo-router": "57.0.25",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.22",
    "expo-splash-screen": "57.0.9",
    "expo-sqlite": "57.0.4",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "expo-task-manager": "57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.3",
    "react-native-worklets": "0.10.1",
    "victory-native": "42.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "typescript": "6.0.3"
  }
}
