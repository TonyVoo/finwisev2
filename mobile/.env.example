# Base URL of the API, without a trailing slash and without the `/v1` prefix
# (route paths in `@expense-tracker/shared` already carry it).
#
# `EXPO_PUBLIC_*` variables are inlined into the bundle at build time, so this is
# the per-environment knob: a local `.env` for development, EAS build env vars for
# preview/production. Nothing secret belongs here — it ships inside the app.
#
#   iOS simulator / web:  http://localhost:3000
#   Android emulator:     http://10.0.2.2:3000
#   physical device:      http://<your-lan-ip>:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
