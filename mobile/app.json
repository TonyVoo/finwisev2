{
  "expo": {
    "name": "Expense Tracker",
    "slug": "expense-tracker",
    "version": "0.1.0",
    "scheme": "expensetracker",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.expensetracker.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.expensetracker.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-background-task",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Expense Tracker uses Face ID to keep your expenses private."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Expense Tracker uses your photos so you can attach a receipt to an expense.",
          "cameraPermission": "Expense Tracker uses the camera so you can photograph a receipt.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8FA",
          "dark": {
            "backgroundColor": "#0F1115",
            "image": "./assets/splash-icon-dark.png"
          },
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": null
    },
    "locales": {
      "vi": "./locales/vi.json"
    },
    "icon": "./assets/icon.png"
  }
}
