{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$meta": {
    "name": "Expense Tracker design tokens",
    "version": "1.0.0",
    "owner": "Designer",
    "source": "docs/design/00-foundations.md",
    "note": "Import these; do not retype hex values into components. Light theme only for the MVP — colours are namespaced under color.light so color.dark is an additive change later."
  },
  "color": {
    "light": {
      "bg": {
        "canvas": "#F7F8FA",
        "surface": "#FFFFFF",
        "sunken": "#EFF1F4",
        "scrim": "rgba(17,24,39,0.45)"
      },
      "text": {
        "primary": "#111827",
        "secondary": "#4B5563",
        "tertiary": "#6B7280",
        "inverse": "#FFFFFF",
        "disabled": "#8C939E"
      },
      "primary": {
        "default": "#0D7A64",
        "pressed": "#0A5F4E",
        "subtle": "#E6F4F1"
      },
      "danger": { "default": "#B3261E", "subtle": "#FDECEA" },
      "warning": { "default": "#8A5300", "subtle": "#FFF4E0" },
      "success": { "default": "#1B6B3A", "subtle": "#E7F5EC" },
      "info": { "default": "#1A4FA0", "subtle": "#E8F0FD" },
      "border": {
        "hairline": "#E2E5EA",
        "strong": "#C8CDD6",
        "input": "#8C939E",
        "focus": "#0D7A64"
      }
    }
  },
  "category": {
    "$note": "Ten hues, all >=4.5:1 on color.light.bg.surface, so a swatch is safe as an icon tint, a chart slice, or text. Separated by hue and not by lightness, which is why colour is never the sole carrier of category identity (00-foundations.md §1.3).",
    "green": "#2F8044",
    "orange": "#A85C12",
    "blue": "#2F6FD0",
    "indigo": "#5B57C7",
    "teal": "#277573",
    "red": "#C73B3B",
    "pink": "#BC4186",
    "purple": "#8E4EC6",
    "ochre": "#8A7012",
    "slate": "#6B7280"
  },
  "categoryPickerOrder": [
    "green",
    "orange",
    "blue",
    "indigo",
    "teal",
    "red",
    "pink",
    "purple",
    "ochre"
  ],
  "categoryReservedColor": {
    "$note": "category.slate is the fallback (isDefault) category colour and is not offered in the picker.",
    "token": "slate",
    "hex": "#6B7280"
  },
  "defaultCategories": {
    "$note": "Mirrors DEFAULT_CATEGORIES in shared/src/category.ts, in the contract's order, with accessible colours substituted. Enforced by docs/design/tests/tokens.test.ts.",
    "items": [
      { "name": "Uncategorized", "colorToken": "slate", "color": "#6B7280", "isDefault": true },
      { "name": "Groceries", "colorToken": "green", "color": "#2F8044", "isDefault": false },
      { "name": "Transport", "colorToken": "blue", "color": "#2F6FD0", "isDefault": false },
      { "name": "Eating out", "colorToken": "orange", "color": "#A85C12", "isDefault": false },
      { "name": "Bills", "colorToken": "purple", "color": "#8E4EC6", "isDefault": false },
      { "name": "Health", "colorToken": "red", "color": "#C73B3B", "isDefault": false }
    ]
  },
  "type": {
    "$note": "Platform default font (San Francisco / Roboto). Do not bundle a custom font for the MVP. allowFontScaling stays true everywhere.",
    "amountHero": { "fontSize": 34, "lineHeight": 40, "fontWeight": "700", "letterSpacing": -0.6, "tabularNums": true },
    "display": { "fontSize": 32, "lineHeight": 40, "fontWeight": "700", "letterSpacing": -0.5, "tabularNums": true },
    "title1": { "fontSize": 24, "lineHeight": 32, "fontWeight": "700", "letterSpacing": -0.3 },
    "title2": { "fontSize": 20, "lineHeight": 28, "fontWeight": "600", "letterSpacing": -0.2 },
    "headline": { "fontSize": 17, "lineHeight": 24, "fontWeight": "600", "letterSpacing": 0 },
    "body": { "fontSize": 16, "lineHeight": 24, "fontWeight": "400", "letterSpacing": 0 },
    "bodyStrong": { "fontSize": 16, "lineHeight": 24, "fontWeight": "600", "letterSpacing": 0 },
    "callout": { "fontSize": 15, "lineHeight": 20, "fontWeight": "400", "letterSpacing": 0 },
    "subhead": { "fontSize": 14, "lineHeight": 20, "fontWeight": "500", "letterSpacing": 0 },
    "footnote": { "fontSize": 13, "lineHeight": 18, "fontWeight": "400", "letterSpacing": 0 },
    "caption": { "fontSize": 12, "lineHeight": 16, "fontWeight": "500", "letterSpacing": 0.2 }
  },
  "space": {
    "$note": "4pt base. space.4 is the screen gutter on both edges, always.",
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radius": { "none": 0, "sm": 6, "md": 10, "lg": 14, "pill": 999 },
  "elevation": {
    "0": { "shadowOpacity": 0, "androidElevation": 0 },
    "1": {
      "shadowColor": "#111827",
      "shadowOpacity": 0.06,
      "shadowRadius": 8,
      "shadowOffset": { "width": 0, "height": 2 },
      "androidElevation": 2
    },
    "2": {
      "shadowColor": "#111827",
      "shadowOpacity": 0.12,
      "shadowRadius": 16,
      "shadowOffset": { "width": 0, "height": 6 },
      "androidElevation": 6
    }
  },
  "motion": {
    "$note": "All durations collapse to 0 and transitions become cross-fades when AccessibilityInfo.isReduceMotionEnabled() is true.",
    "fast": { "duration": 120, "easing": "ease-out" },
    "base": { "duration": 200, "easing": "ease-out" },
    "slow": { "duration": 280, "easing": "ease-in-out" }
  },
  "size": {
    "$note": "Fixed sizes that recur. Row and button heights are floors, not fixed heights — they grow with font scale.",
    "tapTargetMin": 44,
    "rowMinHeight": 56,
    "buttonHeight": 48,
    "inputHeight": 48,
    "fab": 56,
    "appBarHeight": 56,
    "swatch": 24,
    "syncGlyph": 14,
    "donutStrokeWidth": 28,
    "sliceGapStrokeWidth": 2
  },
  "a11y": {
    "contrastBodyMin": 4.5,
    "contrastLargeMin": 3,
    "snackbarMs": 5000,
    "snackbarScreenReaderMs": 10000
  }
}
