{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$meta": {
    "name": "Expense Tracker design tokens",
    "version": "1.0.0",
    "owner": "Designer",
    "source": "docs/design/00-foundations.md",
    "note": "Import these; do not retype hex values into components. Colours are namespaced under color.light and color.dark; the app picks one at launch from the system setting. color.dark and categoryDark were added after the MVP by the developer, not the Designer: they are contrast-checked (tests/theme/darkPalette.test.ts) but have had no design review."
  },
  "color": {
    "light": {
      "bg": {
        "canvas": "#F7F8FA",
        "surface": "#FFFFFF",
        "sunken": "#EFF1F4",
        "scrim": "rgba(17,24,39,0.45)"
      },
      "text": {
        "primary": "#111827",
        "secondary": "#4B5563",
        "tertiary": "#6B7280",
        "inverse": "#FFFFFF",
        "disabled": "#8C939E"
      },
      "primary": {
        "default": "#0D7A64",
        "pressed": "#0A5F4E",
        "subtle": "#E6F4F1"
      },
      "danger": {
        "default": "#B3261E",
        "subtle": "#FDECEA"
      },
      "warning": {
        "default": "#8A5300",
        "subtle": "#FFF4E0"
      },
      "success": {
        "default": "#1B6B3A",
        "subtle": "#E7F5EC"
      },
      "info": {
        "default": "#1A4FA0",
        "subtle": "#E8F0FD"
      },
      "border": {
        "hairline": "#E2E5EA",
        "strong": "#C8CDD6",
        "input": "#8C939E",
        "focus": "#0D7A64"
      }
    },
    "dark": {
      "bg": {
        "canvas": "#0F1115",
        "surface": "#181B20",
        "sunken": "#0A0C0F",
        "scrim": "rgba(0,0,0,0.6)"
      },
      "text": {
        "primary": "#F3F4F6",
        "secondary": "#B4BAC4",
        "tertiary": "#9AA1AD",
        "inverse": "#06140F",
        "disabled": "#6B7280"
      },
      "primary": {
        "default": "#3DBBA0",
        "pressed": "#7FD9C5",
        "subtle": "#12302A"
      },
      "danger": {
        "default": "#F27C73",
        "subtle": "#3A1816"
      },
      "warning": {
        "default": "#F0B04A",
        "subtle": "#33250C"
      },
      "success": {
        "default": "#5BC083",
        "subtle": "#12281A"
      },
      "info": {
        "default": "#7BA7F2",
        "subtle": "#14233D"
      },
      "border": {
        "hairline": "#2A2F37",
        "strong": "#3B424C",
        "input": "#7A8290",
        "focus": "#3DBBA0"
      }
    }
  },
  "category": {
    "$note": "Ten hues, all >=4.5:1 on color.light.bg.surface, so a swatch is safe as an icon tint, a chart slice, or text. Separated by hue and not by lightness, which is why colour is never the sole carrier of category identity (00-foundations.md §1.3).",
    "green": "#2F8044",
    "orange": "#A85C12",
    "blue": "#2F6FD0",
    "indigo": "#5B57C7",
    "teal": "#277573",
    "red": "#C73B3B",
    "pink": "#BC4186",
    "purple": "#8E4EC6",
    "ochre": "#8A7012",
    "slate": "#6B7280"
  },
  "categoryPickerOrder": [
    "green",
    "orange",
    "blue",
    "indigo",
    "teal",
    "red",
    "pink",
    "purple",
    "ochre"
  ],
  "categoryReservedColor": {
    "$note": "category.slate is the fallback (isDefault) category colour and is not offered in the picker.",
    "token": "slate",
    "hex": "#6B7280"
  },
  "defaultCategories": {
    "$note": "Mirrors DEFAULT_CATEGORIES in shared/src/category.ts exactly, in the contract's order and with the same hexes. Seeded server-side at signup; the client reads them. Enforced by shared/tests/tokens.test.ts.",
    "items": [
      {
        "name": "Uncategorized",
        "colorToken": "slate",
        "color": "#6B7280",
        "isDefault": true
      },
      {
        "name": "Groceries",
        "colorToken": "green",
        "color": "#2F8044",
        "isDefault": false
      },
      {
        "name": "Transport",
        "colorToken": "blue",
        "color": "#2F6FD0",
        "isDefault": false
      },
      {
        "name": "Eating out",
        "colorToken": "orange",
        "color": "#A85C12",
        "isDefault": false
      },
      {
        "name": "Bills",
        "colorToken": "purple",
        "color": "#8E4EC6",
        "isDefault": false
      },
      {
        "name": "Health",
        "colorToken": "red",
        "color": "#C73B3B",
        "isDefault": false
      }
    ]
  },
  "type": {
    "$note": "Platform default font (San Francisco / Roboto). Do not bundle a custom font for the MVP. allowFontScaling stays true everywhere.",
    "amountHero": {
      "fontSize": 34,
      "lineHeight": 40,
      "fontWeight": "700",
      "letterSpacing": -0.6,
      "tabularNums": true
    },
    "display": {
      "fontSize": 32,
      "lineHeight": 40,
      "fontWeight": "700",
      "letterSpacing": -0.5,
      "tabularNums": true
    },
    "title1": {
      "fontSize": 24,
      "lineHeight": 32,
      "fontWeight": "700",
      "letterSpacing": -0.3
    },
    "title2": {
      "fontSize": 20,
      "lineHeight": 28,
      "fontWeight": "600",
      "letterSpacing": -0.2
    },
    "headline": {
      "fontSize": 17,
      "lineHeight": 24,
      "fontWeight": "600",
      "letterSpacing": 0
    },
    "body": {
      "fontSize": 16,
      "lineHeight": 24,
      "fontWeight": "400",
      "letterSpacing": 0
    },
    "bodyStrong": {
      "fontSize": 16,
      "lineHeight": 24,
      "fontWeight": "600",
      "letterSpacing": 0
    },
    "callout": {
      "fontSize": 15,
      "lineHeight": 20,
      "fontWeight": "400",
      "letterSpacing": 0
    },
    "subhead": {
      "fontSize": 14,
      "lineHeight": 20,
      "fontWeight": "500",
      "letterSpacing": 0
    },
    "footnote": {
      "fontSize": 13,
      "lineHeight": 18,
      "fontWeight": "400",
      "letterSpacing": 0
    },
    "caption": {
      "fontSize": 12,
      "lineHeight": 16,
      "fontWeight": "500",
      "letterSpacing": 0.2
    }
  },
  "space": {
    "$note": "4pt base. space.4 is the screen gutter on both edges, always.",
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radius": {
    "none": 0,
    "sm": 6,
    "md": 10,
    "lg": 14,
    "pill": 999
  },
  "elevation": {
    "0": {
      "shadowOpacity": 0,
      "androidElevation": 0
    },
    "1": {
      "shadowColor": "#111827",
      "shadowOpacity": 0.06,
      "shadowRadius": 8,
      "shadowOffset": {
        "width": 0,
        "height": 2
      },
      "androidElevation": 2
    },
    "2": {
      "shadowColor": "#111827",
      "shadowOpacity": 0.12,
      "shadowRadius": 16,
      "shadowOffset": {
        "width": 0,
        "height": 6
      },
      "androidElevation": 6
    }
  },
  "motion": {
    "$note": "All durations collapse to 0 and transitions become cross-fades when AccessibilityInfo.isReduceMotionEnabled() is true.",
    "fast": {
      "duration": 120,
      "easing": "ease-out"
    },
    "base": {
      "duration": 200,
      "easing": "ease-out"
    },
    "slow": {
      "duration": 280,
      "easing": "ease-in-out"
    }
  },
  "size": {
    "$note": "Fixed sizes that recur. Row and button heights are floors, not fixed heights — they grow with font scale.",
    "tapTargetMin": 44,
    "rowMinHeight": 56,
    "buttonHeight": 48,
    "inputHeight": 48,
    "fab": 56,
    "appBarHeight": 56,
    "swatch": 24,
    "syncGlyph": 14,
    "donutStrokeWidth": 28,
    "sliceGapStrokeWidth": 2
  },
  "a11y": {
    "contrastBodyMin": 4.5,
    "contrastLargeMin": 3,
    "snackbarMs": 5000,
    "snackbarScreenReaderMs": 10000
  },
  "categoryDark": {
    "green": "#3A9A54",
    "orange": "#C4721F",
    "blue": "#4A87E3",
    "indigo": "#7370DB",
    "teal": "#2F8F8C",
    "red": "#DB5555",
    "pink": "#D0589B",
    "purple": "#A468DA",
    "ochre": "#A68A1E",
    "slate": "#8A919E"
  }
}
