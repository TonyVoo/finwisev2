# Expense Tracker — backend environment.
#
# Copy to `backend/.env` and adjust. `.env` is git-ignored; this file is the checked-in
# template. Values here are the local-development defaults, not secrets.
#
# Note: the backend and the Prisma CLI load this file with `override: true`, so these
# values win over variables already exported in your shell. That is on purpose — in a
# workspace it should never be ambiguous which database you just migrated.

# ---- Required ----------------------------------------------------------------------

# Postgres 16+ connection string for the app.
DATABASE_URL="postgresql://expense:expense@localhost:5432/expense_tracker?schema=public"

# Signing key for access-token JWTs (HS256). Min 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this invalidates every outstanding access token; refresh tokens survive.
JWT_SECRET="dev-only-insecure-secret-change-me-0000"

# ---- Optional ----------------------------------------------------------------------

# HTTP port. Default 3000.
PORT=3000

# "development" | "test" | "production". Default "development".
NODE_ENV=development

# Access-token lifetime in seconds. Default 3600 (1 hour), per the API contract.
# ACCESS_TOKEN_TTL_SECONDS=3600

# Refresh-token lifetime in days. Default 60, per the API contract. Long on purpose:
# an offline-first app must not log the user out because they were offline for a week.
# REFRESH_TOKEN_TTL_DAYS=60

# Number of reverse proxies in front of this process, or "false" for none. Default "false".
#
# Read this before deploying. The login rate limiter has a per-source-address bucket, and
# `req.ip` is only the real client address if Express is told how far to look back through
# `X-Forwarded-For`. Leave it "false" behind a load balancer and every user shares one
# budget; set it higher than the number of proxies you run and a client can forge the
# header to get a fresh budget per guess. Set it to the proxy count, exactly.
# TRUST_PROXY=1

# "pretty" | "json". Default "pretty" locally, "json" when NODE_ENV=production.
# LOG_FORMAT=pretty

# Used only by `pnpm migrate:dev`, which needs a throwaway database to diff against.
# SHADOW_DATABASE_URL="postgresql://expense:expense@localhost:5432/expense_tracker_shadow?schema=public"

# Used only by `pnpm test`. The suite truncates every table between tests, so this must
# NOT point at a database you care about. Defaults to DATABASE_URL with a `_test` suffix.
# TEST_DATABASE_URL="postgresql://expense:expense@localhost:5432/expense_tracker_test?schema=public"

# Accounts that may open the admin page at /admin (docs/design/17-admin.md): comma-separated emails.
# Unset or empty, nobody can. They sign in with their ordinary account; everyone else gets a 404.
# ADMIN_EMAILS=you@example.com

# Outgoing email (password-reset codes). Set BOTH to send through Resend; leave both unset
# in development and the code is printed in the server log instead. MAIL_FROM must be an
# address on a domain you have verified with Resend.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# MAIL_FROM="Expense Tracker <no-reply@yourdomain.com>"

# Reading receipts (POST /v1/receipts/scan). Set ONE of these keys; with neither, the endpoint
# answers 503 ocr_unavailable and the app stops offering "Read receipt" (nothing else depends on
# it). Setting a key means receipt photos are sent to that provider when someone taps the button.
# See docs/design/11-receipt-scan.md.
#
# OCR.space has a free plan (free API key from https://ocr.space/ocrapi, no card): 25,000
# requests a month, 500 a day per server address, files up to 1 MB. Preferred when both are set.
# OCR_SPACE_API_KEY=
#
# Google Cloud Vision: pay as you go, needs a billing account; 1,000 requests a month are free.
# GOOGLE_VISION_API_KEY=

# A vision model reads the photo instead of OCR + a parser (tried first; OCR above is the fallback
# when this fails or its daily budget is spent). Google Gemini has a free tier with no card: get a key
# at https://aistudio.google.com/apikey. On the free tier Google may use requests to improve its
# products, so the photo is sent on that basis whenever someone taps "Read receipt" - say so in your
# privacy policy. See docs/design/14-ai-receipt-reading.md.
# GEMINI_API_KEY=
# Model names are retired on Google's schedule, so this is config. Check the free tier's list.
# GEMINI_MODEL=gemini-3.5-flash-lite
# Calls per Pacific day before falling back to OCR; keep under your model's free daily limit.
# GEMINI_DAILY_BUDGET=500
# Calls per Pacific day for reading typed sentences (quick add); counted apart from the receipt budget.
# GEMINI_QUICK_ADD_DAILY_BUDGET=200
# Calls per Pacific day for writing a month's recap; counted apart from receipts and quick add.
# GEMINI_RECAP_DAILY_BUDGET=100

# The Investing tab: the market service (vn-stock-assistant's api/, run with uvicorn). Unset, /v1/market/*
# answers 503 market_unavailable and nothing else is affected. MARKET_API_KEY must equal the service's own
# MARKET_API_KEY; it is sent as X-Api-Key and never reaches the app.
# MARKET_API_URL=http://localhost:8001
# MARKET_API_KEY=
