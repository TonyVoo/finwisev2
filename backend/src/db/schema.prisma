// Expense Tracker — Postgres schema.
//
// See `docs/PLAN.md` §3 for the decisions this encodes. The ones worth restating
// here, because the schema is where they are enforced:
//
//   * Money is `amountMinor` (an integer in the currency's minor unit) plus a
//     3-letter ISO 4217 code. Never a float, never a decimal string, at rest.
//   * `expenses.date` is a calendar DATE, not a timestamp. It is the day the user
//     assigned to the expense and must not shift across timezones. `createdAt` /
//     `updatedAt` / `deletedAt` are `timestamptz`.
//   * Deletes are soft (`deletedAt`). A sync protocol cannot propagate a hard
//     delete: an absent row is indistinguishable from one the client never saw.
//   * `revision` is a per-user monotonic sequence assigned by the server on every
//     write. It is the sync cursor's watermark — not a timestamp, not a global
//     counter. The counter lives in `revision_counters` and is handed out by the
//     `next_revision(uuid)` SQL function; see the first migration.
//   * Ids are client-minted UUIDv7 and the server accepts them as-is, so a row's
//     identity never changes and foreign keys written offline stay valid. There is
//     deliberately no `@default` on any `id`: the caller always supplies one.

generator client {
  provider     = "prisma-client"
  output       = "./generated"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// An account. Not syncable: there is exactly one user per token and the mobile
/// app reads it from `GET /v1/me`, so it carries no `revision` or tombstone.
model User {
  id String @id @db.Uuid

  /// Stored trimmed and lowercased, and unique. `A@x.com` and `a@x.com` are the
  /// same account. A CHECK constraint in the migration enforces the lowercasing at
  /// the storage layer so a code path that forgets to normalise fails loudly.
  email String @unique @db.VarChar(254)

  /// What other people see instead of the first part of the email: set by the person, optional,
  /// 1-40 characters, trimmed. NULL when they have not chosen one. Not a credential.
  displayName String? @map("display_name") @db.VarChar(40)

  /// argon2id. Never logged, never returned on the wire.
  passwordHash String @map("password_hash") @db.Text

  /// The account's single currency, captured once at signup. No conversion in the MVP.
  currency String @db.Char(3)

  /// Set when the person proves they can read mail sent to `email`. Cleared when the email
  /// changes: it vouches for an address, not for the account.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  revisionCounter RevisionCounter?
  categories      Category[]
  expenses        Expense[]       @relation("ExpenseOwner")
  authoredExpenses Expense[]      @relation("ExpenseAuthor")
  recurringRules  RecurringRule[]
  goals           Goal[]
  refreshTokens   RefreshToken[]
  passwordResetCode PasswordResetCode?
  emailVerificationCode EmailVerificationCode?
  expenseReceipts ExpenseReceipt[]
  syncMutations   SyncMutation[]
  ownedHousehold  Household?       @relation("HouseholdOwner")
  bookOf          Household?       @relation("HouseholdBook")
  householdMember HouseholdMember?

  @@map("users")
}

/// The per-user revision sequence. One row per user, created with the user.
///
/// A Postgres `SEQUENCE` would be wrong here twice over: sequences are global, and
/// they leave gaps when a transaction rolls back. The sync cursor needs a watermark
/// that is per-user, gap-free and monotonic, so it is a counter column bumped by
/// `next_revision()` inside the writing transaction — a rollback takes the
/// increment with it.
model RevisionCounter {
  userId       String @id @map("user_id") @db.Uuid
  lastRevision Int    @default(0) @map("last_revision")

  /// The highest `revision` ever carried by a tombstone that has since been pruned.
  ///
  /// This is the 90-day horizon, expressed in the only currency a sync cursor
  /// understands. A client holding `since < pruned_through_revision` is missing a
  /// delete it can no longer be told about, so `GET /v1/sync` answers
  /// `resyncRequired: true` rather than an incrementally wrong change set that
  /// resurrects the row. Only ever moves forward; 0 means nothing has been pruned.
  prunedThroughRevision Int @default(0) @map("pruned_through_revision")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("revision_counters")
}

/// A user-owned expense category. Syncable.
///
/// Deleting one *reassigns* its expenses to the user's `Uncategorized` default
/// rather than cascading — losing spend history to a category cleanup would be a
/// data-loss bug. Hence `onDelete: Restrict` on the expense side.
model Category {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid

  name String @db.VarChar(64)

  /// `#RRGGBB`. The server assigns one when the client omits it.
  color String @db.Char(7)

  /// True for the seeded `Uncategorized`, which always exists and cannot be deleted.
  isDefault Boolean @default(false) @map("is_default")

  /// Monthly spending limit in minor units, or NULL for none. A CHECK constraint (see the
  /// `category_monthly_budget` migration) keeps it strictly positive, so "no budget" can
  /// only ever be NULL. `bigint` for the same reason `expenses.amount_minor` is.
  monthlyBudgetMinor BigInt? @map("monthly_budget_minor")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  /// The sync pull walks `revision` ascending within a user, so this index is the
  /// one that makes `GET /v1/sync?since=` a range scan. Unique because a revision
  /// is handed out once per user.
  @@unique([userId, revision])
  /// Only one default category per user, and it is the one deletes reassign to.
  @@index([userId, isDefault])
  @@map("categories")
}

/// An expense. Syncable.
model Expense {
  id         String @id @db.Uuid
  userId     String @map("user_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  /// `expense` or `income`; held by a CHECK constraint (Prisma cannot express it).
  kind String @default("expense") @db.VarChar(7)

  /// Integer minor units (1234 = 12.34 USD). `bigint` because the contract allows
  /// up to 999_999_999_999, which overflows `int4`. Still exact as a JS number
  /// (well under 2^53); the row mapper narrows it at the wire boundary.
  amountMinor BigInt @map("amount_minor")

  /// ISO 4217, denormalised from the user so an expense row is self-describing.
  currency String @db.Char(3)

  /// What was actually paid, when that was not the account currency. Both or neither, and
  /// never the account's own currency - held by CHECK constraints. `amount_minor` stays in the
  /// account currency, so every total sums it unchanged.
  originalAmountMinor BigInt?  @map("original_amount_minor")
  originalCurrency    String?  @map("original_currency") @db.Char(3)

  /// Who added it: the *actor* (the account that made the request), which in a household is not
  /// the owner whose id scopes the row. Server-assigned, immutable, and nulled - not cascaded - if
  /// that account is deleted, so a member leaving never costs the household its history.
  createdBy String? @map("created_by") @db.Uuid

  /// Hidden from every household member but `created_by`: to them the row is a deleted
  /// placeholder. Meaningless outside a household, where nobody else sees the book anyway.
  private Boolean @default(false)

  /// Calendar DATE. The day the user assigned to this expense; monthly totals
  /// bucket on it. Deliberately not a timestamp — it must not shift by timezone.
  date DateTime @db.Date

  note String? @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int

  user     User     @relation("ExpenseOwner", fields: [userId], references: [id], onDelete: Cascade)
  author   User?    @relation("ExpenseAuthor", fields: [createdBy], references: [id], onDelete: SetNull)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  receipt  ExpenseReceipt?

  @@unique([userId, revision])
  /// `GET /v1/expenses?from&to` filters by date within a user, newest first.
  @@index([userId, date(sort: Desc)])
  @@index([userId, categoryId])
  @@map("expenses")
}

/// A recurring-expense rule. Syncable.
///
/// Holds no "next date": occurrences are a pure function of `start_date` and `frequency`,
/// and the devices - not the server - create the expenses (see `shared/src/recurring.ts`).
///
/// `category_id` is deliberately **not** a foreign key. A rule whose category is later
/// deleted keeps the id, and the device files its expenses under the `Uncategorized`
/// default instead - so a category delete has nothing extra to reassign and the tombstone
/// sweep has no ordering constraint against this table. Cross-tenant references are
/// refused at write time (`requireOwnCategoryForWrite`), which is where that matters.
model RecurringRule {
  id         String @id @db.Uuid
  userId     String @map("user_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  amountMinor BigInt  @map("amount_minor")
  currency    String  @db.Char(3)
  note        String? @db.VarChar(500)

  /// `weekly` | `monthly`; a CHECK constraint holds it, as for `sync_mutations.status`.
  frequency String @db.VarChar(8)

  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, revision])
  @@map("recurring_rules")
}

/// A savings goal. Syncable. Progress is manual: the device writes the new `savedMinor`
/// when the person records a deposit (see `shared/src/goal.ts`).
model Goal {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid

  name        String  @db.VarChar(60)
  targetMinor BigInt  @map("target_minor")
  savedMinor  BigInt  @default(0) @map("saved_minor")
  currency    String  @db.Char(3)
  deadline    DateTime? @db.Date

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  revision  Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, revision])
  @@map("goals")
}

/// The idempotency ledger for `POST /v1/sync`: one row per `clientMutationId`.
///
/// A push retried after a dropped response must be a no-op that replays the original
/// outcome. Without that, a flaky-network retry double-applies — the single most
/// common offline-sync bug. The guarantee has to live in the database rather than in
/// the resolver, because two retries can arrive concurrently on two connections: the
/// composite primary key is what makes the second one lose, and the loser replays the
/// winner's result instead of applying anything.
///
/// Deliberately stores the *outcome*, not a response snapshot. `status` and `error`
/// are replayed verbatim, while `record` is re-read from the live row at replay time,
/// so a replay still carries the authoritative row rather than a stale copy of one.
model SyncMutation {
  userId           String @map("user_id") @db.Uuid
  clientMutationId String @map("client_mutation_id") @db.Uuid

  /// `category` | `recurring` | `goal` | `expense`. Not a Prisma enum: the wire values are owned by
  /// `SYNC_ENTITIES` in `shared/`, and a second enum here could disagree with it.
  entity String @db.VarChar(16)

  /// The row the mutation addressed, so a replay can re-read it.
  recordId String @map("record_id") @db.Uuid

  /// `applied` | `conflict_server_wins` | `invalid`, per `SYNC_PUSH_STATUSES`.
  status String @db.VarChar(24)

  /// SHA-256 over the canonicalised request item. A retry is byte-identical, so a
  /// *differing* hash under the same id means the client lost track of its outbox —
  /// reported as `mutation_id_reused` rather than silently accepted, which would hide
  /// the bug and apply a mutation under someone else's idempotency key.
  payloadHash String @map("payload_hash") @db.Char(64)

  /// The per-record error envelope for an `invalid` outcome; null otherwise.
  error Json? @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Unique per user, which is the whole point. Keyed user-first so the lookup on
  /// every pushed item is a primary-key probe.
  @@id([userId, clientMutationId])
  /// The ledger is bounded by the same 90-day horizon as tombstones, swept by the
  /// same job. That sweep finds the accounts to visit by scanning `created_at`
  /// across every user, so the index is on `created_at` alone, not user-first.
  @@index([createdAt])
  @@map("sync_mutations")
}

/// A refresh token, stored only as a SHA-256 hash so a database dump cannot be
/// replayed as a session, and so a token can be revoked.
///
/// Tokens are single-use: refreshing stamps `revokedAt` on the presented token and
/// issues a new one. Replaying an already-rotated token is therefore rejected.
/// A pending password-reset code. At most one per user (a new request replaces it); the code
/// is stored only as an HMAC, and dies on expiry, on the fifth wrong guess, or on use.
model PasswordResetCode {
  id        String   @id @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_codes")
}

/// One receipt photo per expense. Not part of the sync cursor (attaching one does not change
/// the expense row), so clients discover them through `GET /v1/receipts`. The bytes live in
/// Postgres: one transaction, one backup, no volume to configure.
model ExpenseReceipt {
  expenseId   String   @id @map("expense_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  contentType String   @map("content_type") @db.VarChar(32)
  bytes       Bytes
  sizeBytes   Int      @map("size_bytes")
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(3)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("expense_receipts")
}

/// A pending email-verification code. One per user, HMAC-only, same lifetime rules as a
/// reset code. Deleted when the email changes, so a code can never confirm a different address.
model EmailVerificationCode {
  id        String   @id @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_codes")
}

model RefreshToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Revoke-all-sessions and expired-token pruning both scan by user.
  @@index([userId])
  @@map("refresh_tokens")
}

/// A shared household (`docs/design/10-households.md`). Its data lives under a **book** of its own
/// (`scope_id`): an account-like row no one can sign in to, so every synced table stays scoped by
/// one `user_id` and ownership can change hands without moving a row. `owner_id` is only the owner
/// *role*.
model Household {
  id        String   @id @db.Uuid
  ownerId   String   @unique @map("owner_id") @db.Uuid
  scopeId   String   @unique @map("scope_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  owner   User              @relation("HouseholdOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  book    User              @relation("HouseholdBook", fields: [scopeId], references: [id], onDelete: Cascade)
  members HouseholdMember[]
  invite  HouseholdInvite?

  @@map("households")
}

/// One row per person in a household, the owner included. `user_id` is unique: a person is in
/// at most one household at a time.
model HouseholdMember {
  householdId String   @map("household_id") @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  /// `owner` | `member`; a CHECK constraint holds it.
  role        String   @db.VarChar(6)
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([householdId, userId])
  @@map("household_members")
}

/// The household's one live invite code, stored only as an HMAC. Single use: joining deletes it.
model HouseholdInvite {
  householdId String   @id @map("household_id") @db.Uuid
  codeHash    String   @unique @map("code_hash") @db.Char(64)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("household_invites")
}
